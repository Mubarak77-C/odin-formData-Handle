<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <style>
    body { font-family: Arial, sans-serif; margin: 40px; background: #f9f9f9; color: #333; }
    .container { max-width: 600px; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    input, textarea, button { display: block; width: 100%; margin-bottom: 12px; padding: 10px; box-sizing: border-box; }
    button { background: #007BFF; color: white; border: none; border-radius: 4px; cursor: pointer; }
    button:hover { background: #0056b3; }
    .error { color: red; background: #ffe6e6; padding: 10px; border-radius: 4px; margin-bottom: 15px; }
    ul { padding-left: 0; list-style: none; }
    li { background: #f1f1f1; padding: 12px; margin-bottom: 8px; border-radius: 4px; display: flex; justify-content: space-between; align-items: center; }
    .actions a, .actions form { display: inline; margin-left: 5px; }
    .actions button { width: auto; display: inline; padding: 5px 10px; background: #dc3545; }
    .actions button.edit { background: #ffc107; color: black; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <h1>User Management Dashboard</h1>

    <!-- Display Validation Errors -->
    <% if (locals.errors) { %>
      <div class="error">
        <ul>
          <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <!-- INSERT FORM -->
    <h2>Add New User</h2>
    <form action="/" method="POST">
      <input type="text" name="firstName" placeholder="First Name" required />
      <input type="text" name="lastName" placeholder="Last Name" required />
      <input type="email" name="email" placeholder="Email Address" required />
      <input type="number" name="age" placeholder="Age (Optional, 18-120)" />
      <textarea name="bio" placeholder="Bio (Max 200 chars) (Optional)"></textarea>
      <button type="submit">Create User</button>
    </form>

    <hr style="margin: 25px 0;">

    <!-- SEARCH FILTER -->
    <h2>Existing Users</h2>
    <form action="/" method="GET" style="display: flex; gap: 10px;">
      <input type="text" name="search" placeholder="Search by name or email..." value="<%= locals.searchQuery || '' %>" style="margin-bottom: 0;" />
      <button type="submit" style="width: 120px; margin-bottom: 0;">Search</button>
      <% if (locals.searchQuery) { %>
        <a href="/" style="padding: 10px; background: #6c757d; color: white; text-decoration: none; border-radius: 4px; text-align: center;">Clear</a>
      <% } %>
    </form>

    <br>

    <!-- USER LIST WITH EDIT & DELETE -->
    <ul>
      <% if (users.length > 0) { %>
        <% users.forEach(user => { %>
          <li>
            <div>
              <strong><%= user.firstName %> <%= user.lastName %></strong> (<%= user.email %>)
              <% if (user.age) { %> | Age: <%= user.age %><% } %>
            </div>
            <div class="actions">
              <a href="/<%= user.id %>/update" style="padding: 5px 10px; background: #ffc107; color: black; text-decoration: none; border-radius: 4px; font-size: 14px;">Edit</a>
              <form action="/<%= user.id %>/delete" method="POST" onsubmit="return confirm('Delete this user?');">
                <button type="submit">Delete</button>
              </form>
            </div>
          </li>
        <% }) %>
      <% } else { %>
        <p style="color: #666; text-align: center;">No matching users found.</p>
      <% } %>
    </ul>
  </div>
</body>
</html>