<!-- Inside the <ul> loop in views/index.ejs -->
<ul>
  <% if (users.length > 0) { %>
    <% users.forEach(user => { %>
      <li>
        ID: <%= user.id %> | Name: <%= user.firstName %> <%= user.lastName %> | Email: <%= user.email %>
        
        <!-- NEW: Edit and Delete actions -->
        <a href="/<%= user.id %>/update">Edit</a>
        
        <form action="/<%= user.id %>/delete" method="POST" style="display:inline;">
          <button type="submit" onclick="return confirm('Are you sure you want to delete this user?');">Delete</button>
        </form>
      </li>
    <% }) %>
  <% } else { %>
    <p>No matching users found.</p>
  <% } %>
</ul>